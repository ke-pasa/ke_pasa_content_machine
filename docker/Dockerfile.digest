FROM ke-pasa-workers-base:latest

# Copy publisher + digest worker code so the package `workers.digest` is available
COPY workers/publisher /app/workers/publisher
COPY workers/digest /app/workers/digest

# Install repo requirements (includes telethon)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy supervisor config for digest
COPY deploy/docker/supervisord.conf.digest /etc/supervisor/conf.d/digest-worker.conf

WORKDIR /app

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
