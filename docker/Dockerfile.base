FROM python:3.12-slim

WORKDIR /app

# Fix for apt-get issues: clean cache and retry with better error handling
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libxml2-dev \
    libxslt-dev \
    libpq-dev \
    netcat-openbsd \
    build-essential \
    pkg-config \
    supervisor \
    cron \
    git \
    libasound2-dev \
    ffmpeg \
    imagemagick \
    libmagic1 \
    fonts-dejavu-core \
    fonts-liberation \
    fontconfig \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Oswald font for Instagram image processing (supports Cyrillic)
# Oswald is similar to Bebas Neue but includes Cyrillic characters
RUN mkdir -p /usr/share/fonts/truetype/oswald && \
    (curl -fsSL https://github.com/googlefonts/OswaldFont/raw/master/fonts/ttf/Oswald-Bold.ttf \
         -o /usr/share/fonts/truetype/oswald/Oswald-Bold.ttf || \
     curl -fsSL https://fonts.gstatic.com/s/oswald/v53/TK3_WkUHHAIjg75cFRf3bXL8LICs1_FvsUtiZTaR.ttf \
         -o /usr/share/fonts/truetype/oswald/Oswald-Bold.ttf || \
     echo "Warning: Oswald font installation failed, will use DejaVu Sans Bold as fallback") && \
    chmod 644 /usr/share/fonts/truetype/oswald/Oswald-Bold.ttf 2>/dev/null || true && \
    fc-cache -fv

# Configure ImageMagick policy for video processing
RUN sed -i 's/<policy domain="path" rights="none" pattern="@\*"\/>/<!-- <policy domain="path" rights="none" pattern="@*"\/> -->/' /etc/ImageMagick-6/policy.xml || true

COPY requirements.txt /app/requirements.txt
# Install heavy dependencies first with optimizations
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir --prefer-binary --only-binary=numpy,scipy,Pillow,imageio,imageio-ffmpeg numpy==2.3.5 Pillow==10.4.0
# Install MoviePy separately with specific version 
RUN pip install --no-cache-dir --prefer-binary --only-binary=:all: imageio imageio-ffmpeg decorator
# Install MoviePy with binary preference
RUN pip install --no-cache-dir moviepy==1.0.3
# Install the rest
RUN pip install --no-cache-dir --prefer-binary -r requirements.txt

# Try to install telethon (optional dependency - continue if it fails)
RUN pip install --no-cache-dir --prefer-binary 'telethon>=1.24.0' || echo "Warning: Telethon installation failed, continuing without it"

COPY workers/tools /app/workers/tools

RUN mkdir -p /var/log/supervisor

COPY deploy/docker/supervisord.conf /etc/supervisor/supervisord.conf

RUN chmod -R 755 /app/workers/tools

ENV PYTHONUNBUFFERED=1
