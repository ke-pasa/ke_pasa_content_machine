FROM ke-pasa-workers-base:latest

COPY workers/publisher /app/workers/publisher

# Create directories for video generation
RUN mkdir -p /app/generated_videos /app/public/videos && \
    chmod 755 /app/generated_videos /app/public/videos

RUN pip install --no-cache-dir -r /app/workers/publisher/requirements.txt

COPY deploy/docker/supervisord.conf.publisher /etc/supervisor/conf.d/publisher-worker.conf

WORKDIR /app

EXPOSE 9001

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]

# Optional: accept base64-encoded X tokens at build time and write them to /app/.x_tokens.json
# Usage: docker build --build-arg X_TOKENS_BASE64="<base64>" -f docker/Dockerfile.publisher .
ARG X_TOKENS_BASE64=""
RUN if [ -n "$X_TOKENS_BASE64" ]; then \
			echo "$X_TOKENS_BASE64" | base64 -d > /app/.x_tokens.json && chmod 600 /app/.x_tokens.json; \
		fi
# Optional: accept base64-encoded Instagram tokens at build time
ARG INSTAGRAM_TOKENS_BASE64=""
RUN if [ -n "$INSTAGRAM_TOKENS_BASE64" ]; then \
		echo "$INSTAGRAM_TOKENS_BASE64" | base64 -d > /app/.instagram_tokens.json && chmod 600 /app/.instagram_tokens.json; \
	fi

# Optional: accept base64-encoded Facebook tokens at build time
ARG FACEBOOK_TOKENS_BASE64=""
RUN if [ -n "$FACEBOOK_TOKENS_BASE64" ]; then \
		echo "$FACEBOOK_TOKENS_BASE64" | base64 -d > /app/.facebook_tokens.json && chmod 600 /app/.facebook_tokens.json; \
	fi