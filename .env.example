# Environment variables for Docker Compose
# Copy this file to .env and fill in your actual values

# Database
POSTGRES_URL=postgresql://user:password@host:port/database

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI - Primary resource (gpt-5.2-chat for heavy tasks)
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key_here

# Azure OpenAI - Secondary resource (gpt-4o-mini for light tasks)
AZURE_OPENAI_ENDPOINT_MINI=https://your-mini-resource.openai.azure.com
AZURE_OPENAI_KEY_MINI=your_azure_openai_mini_key_here

# Azure OpenAI - Embedding resource (text-embedding-3-small)
AZURE_OPENAI_ENDPOINT_EMBEDDING=https://your-embedding-resource.cognitiveservices.azure.com
AZURE_OPENAI_KEY_EMBEDDING=your_azure_embedding_key_here

# Azure DALL-E 3 for image generation
AZURE_DALLE_ENDPOINT=https://your-dalle-resource.cognitiveservices.azure.com/openai/deployments/dall-e-3/images/generations?api-version=2024-02-01
AZURE_DALLE_KEY=your_azure_dalle_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# RSS Worker Configuration
RSS_PARALLEL_FEEDS=6
RSS_PURGE_DAYS=7

# Git Integration (for pushing generated articles)
GIT_KE_PASA_PAT=
ARTICLES_REPO=ke-pasa/ke_pasa_site
ARTICLES_REPO_BRANCH=main

# X (Twitter) API - OAuth 2.0
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# Instagram API - Automatic token creation
INSTAGRAM_ACCESS_TOKEN=IGQxxx...
INSTAGRAM_USER_ID=your_instagram_user_id

# Facebook API - Automatic token creation and refresh
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id

# Option 1: Use permanent page token (recommended, never expires)
FACEBOOK_PAGE_ACCESS_TOKEN=EAABxxx...

# Option 2: Use short-lived user token for auto-refresh
# Get from https://developers.facebook.com/tools/explorer/
# Worker will automatically exchange for long-lived and fetch page token
# FACEBOOK_USER_TOKEN=EAABxxx...
