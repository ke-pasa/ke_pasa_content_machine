# Environment variables for Docker Compose
# Copy this file to .env and fill in your actual values

# Database
POSTGRES_URL=postgresql://user:password@host:port/database

# OpenAI API (used for embeddings / topic vectors and article generation)
OPENAI_API_KEY=your_openai_api_key_here

# Temporary cost controls
# Set to true only when video generation should run again.
ENABLE_VIDEO_GENERATION=false
# Set to true only when imported events should be translated with AI.
ENABLE_EVENT_AI_TRANSLATION=false
# Set to true only when article image generation should run.
ARTICLE_GENERATOR_ENABLE_IMAGES=false

# Gemini API (Google AI Studio key, free tier eligible)
# Used for article categorization/scoring. Get a key at https://aistudio.google.com/apikey
# The model fallback chain (Gemini -> ... -> OpenAI) is hardcoded in
# workers/categorization/CategorizationWorker.py (CATEGORIZATION_MODEL_CHAIN).
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# RSS Worker Configuration
RSS_PARALLEL_FEEDS=6
RSS_PURGE_DAYS=7

# Git Integration (for pushing generated articles)
GIT_KE_PASA_PAT=
ARTICLES_REPO=ke-pasa/ke_pasa_site
ARTICLES_REPO_BRANCH=main

# X (Twitter) API - OAuth 2.0
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# Instagram API - Automatic token creation
INSTAGRAM_ACCESS_TOKEN=IGQxxx...
INSTAGRAM_USER_ID=your_instagram_user_id

# Threads API - Requires separate User ID (different from Instagram)
# Use tools/get_threads_user_id.py to discover your Threads User ID
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=THQxxx...

# Facebook API - Automatic token creation and refresh
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ID=your_facebook_page_id

# Option 1: Use permanent page token (recommended, never expires)
FACEBOOK_PAGE_ACCESS_TOKEN=EAABxxx...

# Option 2: Use short-lived user token for auto-refresh
# Get from https://developers.facebook.com/tools/explorer/
# Worker will automatically exchange for long-lived and fetch page token
# FACEBOOK_USER_TOKEN=EAABxxx...
