# Database connection (choose PG_DSN/POSTGRES_URL or discrete settings)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=content
POSTGRES_URL=
PG_DSN=

# External services
OPENAI_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RSS worker tuning
RSS_FEEDS_FILE=/app/workers/rss/feeds.txt
RSS_MAX_ARTICLES=0
RSS_REQUEST_TIMEOUT=30
RSS_RETRY_ATTEMPTS=3
RSS_RETRY_DELAY=5
RSS_LOCK_LEASE_SEC=300
RSS_ETAG_CACHE=/app/var/rss-cache/rss_etag_cache.json
RSS_LM_CACHE=/app/var/rss-cache/rss_lastmod_cache.json

# Categorization worker tuning
CATEGORIZATION_DETECT_URGENT=true
CATEGORIZATION_URGENT_THRESHOLD=8.0
CATEGORIZATION_UPDATE_ALL=false

# Article generator tuning
GENERATOR_BATCH_SIZE=50
GENERATOR_ARTICLES_DIR=/app/articles
GENERATOR_SAVE_FILES=true
GENERATOR_USE_AI=true
