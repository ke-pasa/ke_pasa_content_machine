---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, CATEGORIES } from '../../consts';
import type { CategoryKey } from '../../consts';

export const getStaticPaths: GetStaticPaths = async () => {
	const paths = Object.keys(CATEGORIES).map((category) => ({
		params: { slug: category },
		props: { category },
	}));
	return paths;
};

const { slug } = Astro.params;
const category = slug as CategoryKey;
const categoryInfo = CATEGORIES[category];

if (!categoryInfo) {
	return Astro.redirect('/404');
}

// Получаем все статьи из всех коллекций
const newsPosts = await getCollection('news');
const articlesPosts = await getCollection('articles');
const guidesPosts = await getCollection('guides');
const legalPosts = await getCollection('legal');
const catalogPosts = await getCollection('catalog');

// Объединяем все посты и фильтруем по категории
const allPosts = [...newsPosts, ...articlesPosts, ...guidesPosts, ...legalPosts, ...catalogPosts]
	.filter((post) => post.data.category === category)
	.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Пагинация
const POSTS_PER_PAGE = 12;
const currentPage = 1; // Можно добавить поддержку пагинации позже
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const posts = allPosts.slice(startIndex, endIndex);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

const seoTitle = `${categoryInfo.name} - ${SITE_TITLE}`;
const seoDescription = categoryInfo.description;
---

<BaseLayout title={seoTitle} description={seoDescription}>
	<Header />
	
	<main>
		<div class="container">
			<div class="category-header">
				<div class="category-icon">{categoryInfo.icon}</div>
				<h1 class="category-title">{categoryInfo.name}</h1>
				<p class="category-description">{categoryInfo.description}</p>
				<div class="category-stats">
					Найдено статей: {allPosts.length}
				</div>
			</div>

			{posts.length > 0 ? (
				<div class="posts-grid">
					{posts.map((post) => (
						<article class="post-card">
							{post.data.image && (
								<div class="post-image">
									<img src={post.data.image.src} alt="" />
								</div>
							)}
							<div class="post-content">
								<div class="post-meta">
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('ru-RU')}
									</time>
									{post.data.author && <span class="post-author">{post.data.author}</span>}
								</div>
								<h2 class="post-title">
									<a href={`/${post.collection}/${post.slug}`}>{post.data.title}</a>
								</h2>
								<p class="post-description">{post.data.description}</p>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.slice(0, 3).map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								)}
							</div>
						</article>
					))}
				</div>
			) : (
				<div class="no-posts">
					<p>В этой категории пока нет статей.</p>
				</div>
			)}

			{totalPages > 1 && (
				<div class="pagination">
					{/* Здесь можно добавить пагинацию */}
				</div>
			)}
		</div>
	</main>

	<Footer />

	<style>
		.category-header {
			text-align: center;
			padding: var(--space-16) 0;
			background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
			color: white;
			margin-bottom: var(--space-12);
			border-radius: var(--radius-xl);
		}

		.category-icon {
			font-size: 4rem;
			margin-bottom: var(--space-4);
		}

		.category-title {
			font-size: var(--font-size-4xl);
			font-weight: 700;
			margin-bottom: var(--space-4);
		}

		.category-description {
			font-size: var(--font-size-lg);
			opacity: 0.9;
			margin-bottom: var(--space-6);
			max-width: 600px;
			margin-left: auto;
			margin-right: auto;
		}

		.category-stats {
			font-size: var(--font-size-sm);
			opacity: 0.8;
		}

		.posts-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
			gap: var(--space-8);
			margin-bottom: var(--space-12);
		}

		.post-card {
			background: white;
			border-radius: var(--radius-xl);
			box-shadow: var(--shadow-sm);
			border: 1px solid var(--color-gray-200);
			overflow: hidden;
			transition: all var(--transition-normal);
		}

		.post-card:hover {
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}

		.post-image {
			width: 100%;
			height: 200px;
			overflow: hidden;
		}

		.post-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.post-content {
			padding: var(--space-6);
		}

		.post-meta {
			display: flex;
			gap: var(--space-4);
			font-size: var(--font-size-sm);
			color: var(--color-gray-500);
			margin-bottom: var(--space-3);
		}

		.post-title {
			font-size: var(--font-size-lg);
			font-weight: 700;
			margin-bottom: var(--space-3);
		}

		.post-title a {
			color: var(--color-gray-900);
			text-decoration: none;
			transition: color var(--transition-fast);
		}

		.post-title a:hover {
			color: var(--color-primary);
		}

		.post-description {
			color: var(--color-gray-600);
			line-height: var(--line-height-relaxed);
			margin-bottom: var(--space-4);
		}

		.post-tags {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
		}

		.no-posts {
			text-align: center;
			padding: var(--space-16);
			color: var(--color-gray-600);
		}

		.pagination {
			display: flex;
			justify-content: center;
			margin-top: var(--space-12);
		}

		@media (max-width: 768px) {
			.category-header {
				padding: var(--space-12) 0;
			}

			.category-title {
				font-size: var(--font-size-3xl);
			}

			.posts-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</BaseLayout> 