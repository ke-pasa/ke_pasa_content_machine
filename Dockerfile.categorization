# Categorization Worker Dockerfile
FROM ke-pasa-workers-base:latest

# Copy Categorization worker code
COPY workers/categorization /app/workers/categorization

# Install Categorization-specific dependencies
RUN pip install --no-cache-dir -r /app/workers/categorization/requirements.txt

# Copy supervisor configuration for Categorization worker
COPY supervisord.conf.categorization /etc/supervisor/conf.d/categorization-worker.conf

# Set working directory
WORKDIR /app

# Expose supervisor control port (optional, for debugging)
EXPOSE 9001

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
