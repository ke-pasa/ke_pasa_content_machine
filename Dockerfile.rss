# RSS Worker Dockerfile
FROM ke-pasa-workers-base:latest

# Copy RSS worker code
COPY workers/rss /app/workers/rss

# Install RSS-specific dependencies
RUN pip install --no-cache-dir -r /app/workers/rss/requirements.txt

# Copy supervisor configuration for RSS worker
COPY supervisord.conf.rss /etc/supervisor/conf.d/rss-worker.conf

# Set working directory
WORKDIR /app

# Expose supervisor control port (optional, for debugging)
EXPOSE 9001

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
