[program:article-generator-worker]
command=python -m workers.article_generator.worker --continuous --git-sync-interval 30
directory=/app
user=root
autostart=true
autorestart=true
redirect_stderr=true
# Send stdout to container's stdout to allow `docker logs` to show it
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
stdout_logfile_backups=0
startsecs=10
stopwaitsecs=30
