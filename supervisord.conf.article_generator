[program:article-generator-worker]
command=/bin/bash -c "while true; do python -m workers.article_generator.worker; sleep 1800; done"
directory=/app
user=root
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/article-generator-worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
startsecs=10
stopwaitsecs=30
