[program:article-generator-worker]
command=python -m workers.article_generator.worker --continuous --git-sync-interval 30
directory=/app
user=root
autostart=true
autorestart=true
redirect_stderr=true
stdout_logfile=/var/log/supervisor/article-generator-worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=3
startsecs=10
stopwaitsecs=30
