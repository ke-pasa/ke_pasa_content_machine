# Article Generator Worker Dockerfile
FROM ke-pasa-workers-base:latest

# Copy Article Generator worker code
COPY workers/article_generator /app/workers/article_generator

# Install Article Generator-specific dependencies
RUN pip install --no-cache-dir -r /app/workers/article_generator/requirements.txt

# Copy supervisor configuration for Article Generator worker
COPY supervisord.conf.article_generator /etc/supervisor/conf.d/article-generator-worker.conf

# Set working directory
WORKDIR /app

# Expose supervisor control port (optional, for debugging)
EXPOSE 9001

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
