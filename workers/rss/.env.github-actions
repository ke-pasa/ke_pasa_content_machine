# GitHub Actions Environment Variables for RSS Worker
# Add these as Repository Secrets in GitHub Settings > Secrets and variables > Actions

# Required secrets:
# OPENAI_API_KEY=your_openai_api_key_here  # Not needed - LLM filtering disabled

# Optional environment variables (can be set in workflow file):
RSS_FEEDS_FILE=workers/rss/feeds.txt
RSS_LOCK_LEASE_SEC=1800
RSS_MAX_ITEMS_PER_FEED=10
RSS_PER_HOST_DELAY_MS=1000
RSS_REQUEST_TIMEOUT=30
RSS_RETRY_ATTEMPTS=3
RSS_RETRY_DELAY=5
BYPASS_DB_CACHE=0

# Additional configuration for CI environment:
RSS_USER_AGENT=GitHubActions-RSSWorker/1.0
RSS_ETAG_CACHE=/tmp/rss_etag_cache.json
RSS_LM_CACHE=/tmp/rss_lastmod_cache.json