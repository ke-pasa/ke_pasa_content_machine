[program:article-generator-worker]
command=python -m workers.article_generator.worker --continuous --git-sync-interval 30
directory=/app
user=root
autostart=true
autorestart=true
# Do not redirect stderr into stdout (we will handle both streams separately)
redirect_stderr=false
# Send stdout/stderr to container's stdout/stderr so `docker logs` shows them
# AND to persistent log file
stdout_logfile=/app/logs/article-generator-worker.log
stdout_logfile_maxbytes=10485760
stdout_logfile_backups=3
stderr_logfile=/app/logs/article-generator-worker.error.log
stderr_logfile_maxbytes=10485760
stderr_logfile_backups=3
startsecs=10
stopwaitsecs=30

[program:git-sync]
; Use the daemon script under workers/article_generator (scripts/ path does not exist in image)
command=python workers/article_generator/git_sync_daemon.py --interval 30 --trigger-file sync_now.flag
directory=/app
user=root
autostart=true
autorestart=true
# Keep stderr separate
redirect_stderr=false
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stdout_logfile_backups=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
stderr_logfile_backups=0
startsecs=10
stopwaitsecs=30
