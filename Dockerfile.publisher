# Publisher Worker Dockerfile
FROM ke-pasa-workers-base:latest

# Copy Publisher worker code
COPY workers/publisher /app/workers/publisher

# Install Publisher-specific dependencies
RUN pip install --no-cache-dir -r /app/workers/publisher/requirements.txt

# Copy supervisor configuration for Publisher worker
COPY supervisord.conf.publisher /etc/supervisor/conf.d/publisher-worker.conf

# Set working directory
WORKDIR /app

# Expose supervisor control port (optional, for debugging)
EXPOSE 9001

# Start supervisord
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
